{
  "name": "ziqodevs-site",
  "description": "ziqodevs \u2014 independent developer group. React + TypeScript single-page site, edge-rendered assets on Cloudflare Workers.",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run icons && npm run typecheck && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "icons": "node scripts/build-icons.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build:fast && wrangler dev --ip 0.0.0.0 --port 8787",
    "cf:tail": "wrangler tail",
    "cf:login": "wrangler login",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build:fast && npm run smoke"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.131.1"
  }
}
